{% extends 'admin/base.twig' %}

{% block title %}Admin sign in{% endblock %}

{% block content %}
  <section class="mx-auto max-w-sm rounded border border-slate-200 bg-white p-5 shadow-sm">
    <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-forest-800">Restricted area</p>
    <h1 class="mt-1 font-display text-3xl font-bold">Manage free-bet offers</h1>
    {% if error %}<p class="mt-4 rounded bg-rose-50 px-3 py-2 text-xs text-rose-800" role="alert">{{ error }}</p>{% endif %}
    {% if configured %}
      <form class="mt-5 space-y-4" method="post" action="/admin/login">
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <label class="grid gap-1 text-xs font-semibold" for="password">
          Admin password
          <input class="min-h-10 rounded border border-slate-300 px-3 font-normal outline-none focus:border-forest-700" id="password" name="password" type="password" autocomplete="current-password" required>
        </label>
        <button class="min-h-10 w-full rounded bg-forest-900 px-4 text-xs font-bold text-white hover:bg-forest-800" type="submit">Sign in</button>
      </form>
    {% else %}
      <p class="mt-4 text-sm leading-relaxed text-slate-600">Admin access is disabled until <code>FREEBETS_ADMIN_PASSWORD_HASH</code> is configured.</p>
    {% endif %}
  </section>
{% endblock %}