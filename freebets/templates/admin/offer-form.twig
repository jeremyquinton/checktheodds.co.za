{% extends 'admin/base.twig' %}

{% block title %}{{ offer.id ? 'Edit offer' : 'Add offer' }}{% endblock %}

{% block content %}
  <div class="mx-auto max-w-3xl">
    <a class="text-xs font-semibold text-forest-800 hover:underline" href="/admin/offers">← All offers</a>
    <h1 class="mt-2 font-display text-3xl font-bold">{{ offer.id ? 'Edit offer' : 'Add offer' }}</h1>
    {% if error %}<p class="mt-3 rounded bg-rose-50 px-3 py-2 text-xs text-rose-800" role="alert">{{ error }}</p>{% endif %}

    <form class="mt-5 grid gap-4 rounded border border-slate-200 bg-white p-4 sm:grid-cols-2 sm:p-6" method="post" action="/admin/offers/save">
      <input type="hidden" name="_csrf" value="{{ csrf }}">
      <input type="hidden" name="id" value="{{ offer.id|default('') }}">

      {% set fields = [
        {name:'slug', label:'Offer slug', required:true, help:'Unique, lowercase, hyphenated identifier.'},
        {name:'bookmaker_name', label:'Bookmaker', required:true},
        {name:'headline', label:'Offer headline', required:true},
        {name:'description', label:'Short description', required:true},
        {name:'bonus_amount', label:'Bonus amount', type:'number', step:'0.01', min:'0'},
        {name:'currency', label:'Currency', required:true},
        {name:'minimum_deposit', label:'Minimum deposit'},
        {name:'wagering_requirements', label:'Wagering requirements'},
        {name:'qualifying_odds', label:'Qualifying odds', type:'number', step:'0.01', min:'1'},
        {name:'valid_for', label:'Valid for'},
        {name:'offer_url', label:'Bookmaker offer URL', type:'url', required:true}
      ] %}
      {% for field in fields %}
        <label class="grid content-start gap-1 text-xs font-semibold {{ field.name == 'description' or field.name == 'offer_url' ? 'sm:col-span-2' : '' }}" for="{{ field.name }}">
          {{ field.label }}
          <input class="min-h-10 rounded border border-slate-300 px-3 font-normal outline-none focus:border-forest-700" id="{{ field.name }}" name="{{ field.name }}" type="{{ field.type|default('text') }}" value="{{ attribute(offer, field.name)|default('') }}" {% if field.step is defined %}step="{{ field.step }}"{% endif %} {% if field.min is defined %}min="{{ field.min }}"{% endif %} {% if field.required %}required{% endif %}>
          {% if field.help is defined %}<span class="font-normal text-slate-500">{{ field.help }}</span>{% endif %}
        </label>
      {% endfor %}

      <label class="grid content-start gap-1 text-xs font-semibold" for="category">
        Offer category
        <select class="min-h-10 rounded border border-slate-300 bg-white px-3 font-normal" id="category" name="category">
          <option value="free-bets" {{ offer.category == 'free-bets' ? 'selected' : '' }}>Free bets</option>
          <option value="no-deposit" {{ offer.category == 'no-deposit' ? 'selected' : '' }}>No deposit</option>
          <option value="deposit-match" {{ offer.category == 'deposit-match' ? 'selected' : '' }}>Deposit match</option>
        </select>
      </label>

      <label class="grid gap-1 text-xs font-semibold sm:col-span-2" for="terms_text">
        Terms and eligibility
        <textarea class="min-h-32 rounded border border-slate-300 p-3 font-normal leading-relaxed outline-none focus:border-forest-700" id="terms_text" name="terms_text" placeholder="One term per line">{{ offer.terms_text|default('') }}</textarea>
      </label>

      <div class="flex flex-wrap gap-5 text-xs sm:col-span-2">
        <label class="flex items-center gap-2"><input name="is_active" type="checkbox" value="1" {{ offer.is_active ? 'checked' : '' }}> Active on public page</label>
        <label class="flex items-center gap-2"><input name="is_example" type="checkbox" value="1" {{ offer.is_example ? 'checked' : '' }}> Illustrative example, not a verified promotion</label>
      </div>

      <div class="flex justify-end gap-3 border-t border-slate-100 pt-4 sm:col-span-2">
        <a class="inline-flex min-h-10 items-center rounded border border-slate-300 px-4 text-xs font-semibold" href="/admin/offers">Cancel</a>
        <button class="min-h-10 rounded bg-forest-900 px-5 text-xs font-bold text-white hover:bg-forest-800" type="submit">Save offer</button>
      </div>
    </form>
  </div>
{% endblock %}