{% extends 'admin/base.twig' %}

{% block title %}Scraped promotions{% endblock %}

{% block content %}
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-forest-800">Bethunter</p>
      <h1 class="mt-1 font-display text-3xl font-bold">Scraped promotions</h1>
    </div>
    <a class="inline-flex min-h-10 items-center rounded border border-slate-300 px-4 text-xs font-semibold text-forest-900 hover:bg-white" href="/admin/offers">Manual offers</a>
  </div>

  <p class="mt-3 text-xs text-slate-600">Review source offers, curate how they appear publicly, and publish only the promotions you have checked. Scrapes update source data without replacing your curation.</p>

  <div class="mt-5 overflow-x-auto rounded border border-slate-200 bg-white">
    <table class="w-full min-w-[760px] border-collapse text-left text-xs">
      <thead class="bg-forest-950 text-white">
        <tr><th class="px-3 py-3">Bookmaker / source offer</th><th class="px-3 py-3">Display category</th><th class="px-3 py-3">Publication</th><th class="px-3 py-3">Source status</th><th class="px-3 py-3">Last seen</th><th class="px-3 py-3 text-right">Action</th></tr>
      </thead>
      <tbody>
        {% for promotion in promotions %}
          <tr class="border-t border-slate-100 align-top">
            <td class="px-3 py-3">
              <strong class="block">{{ promotion.bookmaker_name }}</strong>
              <span class="text-slate-600">{{ promotion.title }}</span>
              <div class="mt-2 flex flex-wrap gap-3">
                <a class="font-semibold text-forest-800 hover:underline" href="{{ promotion.source_url }}" target="_blank" rel="noopener noreferrer">Source page</a>
                <a class="font-semibold text-forest-800 hover:underline" href="{{ promotion.action_url }}" target="_blank" rel="noopener noreferrer">Action / claim link</a>
              </div>
            </td>
            <td class="px-3 py-3">{{ promotion.display_category }}</td>
            <td class="px-3 py-3"><span class="rounded px-2 py-1 text-[10px] font-bold {{ promotion.is_published ? 'bg-emerald-100 text-emerald-900' : 'bg-amber-100 text-amber-900' }}">{{ promotion.is_published ? 'Published' : 'Draft' }}</span></td>
            <td class="px-3 py-3"><span class="rounded px-2 py-1 text-[10px] font-bold {{ promotion.source_is_active ? 'bg-emerald-100 text-emerald-900' : 'bg-slate-100 text-slate-600' }}">{{ promotion.source_is_active ? 'Active at source' : 'Not found in latest scrape' }}</span></td>
            <td class="px-3 py-3 text-slate-600">{{ promotion.last_seen_at|date('j M Y H:i') }}</td>
            <td class="px-3 py-3 text-right"><a class="font-semibold text-forest-800 hover:underline" href="/admin/promotions/{{ promotion.id }}/edit">Review / edit</a></td>
          </tr>
        {% else %}
          <tr><td class="px-3 py-8 text-center text-slate-500" colspan="6">No scraped promotions yet. Run a bookmaker promotions scraper to import source offers.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endblock %}